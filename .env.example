# ============================================================
# Salon One 連携（サーバー専用 — クライアントには一切露出しません）
# 未設定の場合はデモ（モック）データで動作します。
# 実際の値は .env.local（gitignore 済み）や Vercel の
# Environment Variables に設定してください。
# ============================================================

# APIベースURL（既定: https://salonone.net）
SALONONE_BASE_URL=https://salonone.net

# ログイン情報（Salon One の企業コード / ログインID / パスワード）
SALONONE_BRAND_CODE=
SALONONE_LOGIN_ID=
SALONONE_PASSWORD=

# 任意: マスタ同期キャッシュのTTL（秒、既定 300）
# SALONONE_MASTER_TTL_SECONDS=300

# 任意: 名称に「テスト / [TEST] / 検証」を含むブランド・店舗も表示する場合は 1
# SALONONE_INCLUDE_TEST=
